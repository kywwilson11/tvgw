%%{init: {"theme": "base", "themeVariables": {"fontFamily": "ui-sans-serif, system-ui, sans-serif", "fontSize": "14px", "lineColor": "#64748B", "textColor": "#0F172A", "edgeLabelBackground": "#F1F5F9", "primaryBorderColor": "#94A3B8", "clusterBkg": "#F8FAFC", "clusterBorder": "#CBD5E1"}, "flowchart": {"curve": "basis", "nodeSpacing": 40, "rankSpacing": 60, "padding": 12}}}%%
flowchart LR
    TV["Smart TV<br/>wired to the TV port"]:::tv
    subgraph PI["Gateway: enforcement"]
        direction TB
        FW["nftables<br/>inet tvgw"]:::gw
        DNS["AdGuard Home<br/>port 53"]:::gw
        URL["nginx URL filter<br/>ports 80 and 443"]:::gw
        DHCP["dnsmasq<br/>the TV's lease"]:::gw
    end
    ROUTER(("Home router<br/>uplink port")):::out
    NET(("Internet")):::out
    DOH(("Encrypted DNS upstreams")):::out
    TV -- "every packet" --> FW
    FW -- "DNS to any resolver, redirected" --> DNS
    FW -- "LG's update-filter host, rewritten" --> URL
    FW -- "lease and renewals" --> DHCP
    FW -- "allowed connections, policy-routed" --> ROUTER --> NET
    DNS -- "the Pi's own route" --> DOH
    classDef tv fill:#F59E0B,stroke:#B45309,color:#1F1300,stroke-width:2px
    classDef gw fill:#2563EB,stroke:#1E3A8A,color:#FFFFFF,stroke-width:2px
    classDef obs fill:#10B981,stroke:#047857,color:#062B1F,stroke-width:2px
    classDef store fill:#0F766E,stroke:#134E4A,color:#FFFFFF,stroke-width:2px
    classDef mind fill:#7C3AED,stroke:#4C1D95,color:#FFFFFF,stroke-width:2px
    classDef out fill:#E5E7EB,stroke:#6B7280,color:#111827,stroke-width:2px
    classDef owner fill:#F43F5E,stroke:#9F1239,color:#FFFFFF,stroke-width:2px
