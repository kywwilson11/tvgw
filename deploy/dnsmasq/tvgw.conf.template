# tvgw: DHCP only for the TV subnet; DNS is AdGuard Home on port 53. install.sh fills in the
# placeholders from /etc/tvgw/tvgw.conf (TV_IF, GW_IP, and the pool and netmask it derives from TV_NET)
port=0
interface=__TV_IF__
bind-dynamic
dhcp-authoritative
dhcp-range=__DHCP_FIRST__,__DHCP_LAST__,__TV_NETMASK__,12h
dhcp-option=option:router,__GW_IP__
dhcp-option=option:dns-server,__GW_IP__
# the TV's wired MAC, pinned so logs and the AdGuard client stay attributable (`tvgw discover --write`
# fills it in; the installer leaves this line out until then)
dhcp-host=__TV_MAC__,__TV_IP__,__TV_NAME__
log-dhcp
# (guard) every reply broadcast, and no ping before an offer: with both, dnsmasq needs neither
# CAP_NET_ADMIN (which it keeps only to write the ARP cache for a unicast offer) nor CAP_NET_RAW (only
# for the ping), and CAP_NET_ADMIN is enough to rewrite the firewall. One host on the segment has no
# address conflict for a ping to find (design decision 42, 20-tvgw-hardening.conf beside this file)
dhcp-broadcast
no-ping
