# tvgw (design decision 42): dnsmasq parses every DHCP packet the TV sends, so it runs with the least
# it needs. install.sh fills in __TV_NET__ and writes this to
# /etc/systemd/system/dnsmasq.service.d/20-tvgw-hardening.conf, restarts dnsmasq, and removes it again
# if dnsmasq is not then active and holding UDP 67: the TV must never lose DHCP to a hardening line.
# With dhcp-broadcast and no-ping in tvgw.conf, dnsmasq (2.91, src/dnsmasq.c) asks for neither
# CAP_NET_ADMIN nor CAP_NET_RAW, and dies at start with "process is missing required capability" if
# it would still need one. The bounding set is what it uses as root before it drops to the dnsmasq
# user: binding port 67, setuid and setgid, chown of /run/dnsmasq, and CAP_DAC_OVERRIDE to write its
# pid file into /run/dnsmasq, which is the dnsmasq user's (mode 755). After the drop it keeps none.
[Service]
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/misc -/run
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# DHCP only, on the TV subnet: a DISCOVER from 0.0.0.0, replies to 255.255.255.255, renewals by unicast
IPAddressDeny=any
IPAddressAllow=localhost 0.0.0.0/32 255.255.255.255/32 __TV_NET__
