#!/bin/bash
# tvgw-extract: turn the eth0 pcaps into text that tvgw-report reads.
#   /var/lib/tvgw/archive/{sni,http,dns}.tsv   every finished pcap, extracted once, kept ARCHIVE_DAYS
#   /var/lib/tvgw/{sni,http}.tsv, querylog.json  archive + the pcap tcpdump is still writing, last
#                                               REPORT_WINDOW: the files tvgw-report reads by default
# usage: sudo tvgw-extract [--window 30d] [--rebuild]
#   --window   how much of the archive goes into the report files (default REPORT_WINDOW, 8d)
#   --rebuild  forget what was extracted and redo every pcap still on disk (older archive rows are lost)
# Settings come from /etc/tvgw/tvgw.conf: ARCHIVE_DAYS (90), REPORT_WINDOW (8d).
# Runs hourly from tvgw-analyze; safe to run by hand at any time (it takes a lock).
set -euo pipefail
[ ! -f /etc/tvgw/tvgw.conf ] || . /etc/tvgw/tvgw.conf
STATE=/var/lib/tvgw
PCAPS=$STATE/pcap
ARCHIVE=$STATE/archive
WINDOW=${REPORT_WINDOW:-8d}
RETAIN=${ARCHIVE_DAYS:-90}

rebuild=no
while [ $# -gt 0 ]; do
	case "$1" in
	--window) WINDOW=$2; shift 2 ;;
	--rebuild) rebuild=yes; shift ;;
	*) echo "usage: tvgw-extract [--window 8d] [--rebuild]" >&2; exit 2 ;;
	esac
done
case "$WINDOW" in
	*h) win_s=$((${WINDOW%h} * 3600)) ;;
	*d) win_s=$((${WINDOW%d} * 86400)) ;;
	*w) win_s=$((${WINDOW%w} * 604800)) ;;
	*) echo "tvgw-extract: bad --window '$WINDOW' (use 12h, 8d or 2w)" >&2; exit 2 ;;
esac

exec 9>/run/lock/tvgw-extract.lock
flock -w 900 9 || { echo "tvgw-extract: another run has held the lock for 15 min; giving up" >&2; exit 1; }
install -d -m 755 "$ARCHIVE"
if [ "$rebuild" = yes ]; then
	echo "tvgw-extract: rebuilding the archive from the pcaps still on disk"
	rm -f "$ARCHIVE"/{sni,http,dns}.tsv "$ARCHIVE/done.list"
fi
touch "$ARCHIVE"/{sni,http,dns}.tsv "$ARCHIVE/done.list"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# One tshark pass over a pcap: TLS ClientHello names, plain-HTTP requests and DNS answers,
# split into PREFIX.sni / .http / .dns with the columns tvgw-report expects.
extract() { # extract PCAP PREFIX
	local rc=0
	tshark -r "$1" -n \
		-Y '(tls.handshake.type == 1 && tls.handshake.extensions_server_name) || http.request || (dns.flags.response == 1 && udp.srcport == 53)' \
		-T fields -e frame.time_epoch -e ip.src -e tcp.srcport -e ip.dst -e tcp.dstport \
		-e tls.handshake.extensions_server_name \
		-e http.request.method -e http.host -e http.request.uri -e http.user_agent -e http.content_length \
		-e udp.srcport -e dns.qry.name -e dns.a -e dns.aaaa -e dns.flags.rcode \
		>"$tmp/fields" 2>"$tmp/err" || rc=$?
	grep -vE 'Running as user|cut short in the middle' "$tmp/err" >&2 || true
	# 2 = "cut short": expected for the pcap tcpdump is still writing, harmless for a finished one
	[ "$rc" = 0 ] || [ "$rc" = 2 ] || return "$rc"
	python3 -I - "$tmp/fields" "$2" <<'EOF'
import sys
out = {k: open(f"{sys.argv[2]}.{k}", "w") for k in ("sni", "http", "dns")}
for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
    f = line.rstrip("\n").split("\t")
    if len(f) < 16:
        continue
    t, src, sport, dst, dport, sni, method, host, uri, ua, clen, usport, qname, a, aaaa, rcode = f[:16]
    if sni:
        out["sni"].write("\t".join((t, src, sport, dst, dport, sni)) + "\n")
    elif method:
        out["http"].write("\t".join((t, dst, method, host, uri, ua, clen)) + "\n")
    elif qname and usport == "53":
        out["dns"].write("\t".join((t, dst, qname, a, aaaa, rcode)) + "\n")
EOF
}

# ---- Archive: every finished pcap exactly once -----------------------------------
# File names carry the start time, so sorted order is chronological; the newest one is
# the file tcpdump is still writing and is only used for the report files below.
mapfile -t pcaps < <(ls -1 "$PCAPS"/*.pcap 2>/dev/null | sort)
live=""
[ ${#pcaps[@]} -eq 0 ] || live=${pcaps[-1]}
added=0
for p in "${pcaps[@]}"; do
	[ "$p" != "$live" ] || continue
	name=$(basename "$p")
	grep -qxF "$name" "$ARCHIVE/done.list" && continue
	if ! extract "$p" "$tmp/x"; then
		echo "tvgw-extract: $name: tshark failed; will retry next run" >&2
		continue
	fi
	cat "$tmp/x.sni" >>"$ARCHIVE/sni.tsv"
	cat "$tmp/x.http" >>"$ARCHIVE/http.tsv"
	cat "$tmp/x.dns" >>"$ARCHIVE/dns.tsv"
	echo "$name" >>"$ARCHIVE/done.list"
	added=$((added + 1))
done
# Forget pcaps tvgw-prune has deleted; their rows stay in the archive until ARCHIVE_DAYS
ls -1 "$PCAPS" 2>/dev/null >"$tmp/present" || true
grep -xFf "$tmp/present" "$ARCHIVE/done.list" >"$tmp/done" || true
mv -f "$tmp/done" "$ARCHIVE/done.list"

# Age out archive rows (rows are appended in time order, so line 1 is the oldest)
cutoff=$(($(date +%s) - RETAIN * 86400))
for k in sni http dns; do
	first=$(head -1 "$ARCHIVE/$k.tsv" | cut -f1 | cut -d. -f1)
	if [ -n "$first" ] && [ "$first" -lt "$cutoff" ]; then
		awk -F'\t' -v c="$cutoff" '$1 >= c' "$ARCHIVE/$k.tsv" >"$ARCHIVE/.$k.tmp"
		mv -f "$ARCHIVE/.$k.tmp" "$ARCHIVE/$k.tsv"
	fi
done

# ---- Report files: last WINDOW of the archive plus the live pcap -------------------
for k in sni http dns; do : >"$tmp/live.$k"; done
if [ -n "$live" ] && ! extract "$live" "$tmp/live"; then
	echo "tvgw-extract: $(basename "$live"): tshark failed; report files lack the current hour" >&2
fi
since=$(($(date +%s) - win_s))
for k in sni http dns; do
	{ awk -F'\t' -v s="$since" '$1 >= s' "$ARCHIVE/$k.tsv"; cat "$tmp/live.$k"; } >"$tmp/view.$k"
done
mv -f "$tmp/view.sni" "$STATE/sni.tsv"
mv -f "$tmp/view.http" "$STATE/http.tsv"
chmod 644 "$STATE/sni.tsv" "$STATE/http.tsv"

# dns rows -> the AdGuard /control/querylog shape that tvgw-report reads
python3 -I - "$tmp/view.dns" >"$tmp/querylog.json" <<'EOF'
import json, sys
from datetime import datetime, timezone
rows = []
for line in open(sys.argv[1]):
    f = line.rstrip("\n").split("\t")
    if len(f) < 6 or not f[2]:
        continue
    t, client, name, a, aaaa, rcode = f[:6]
    ans = [{"type": "A", "value": v} for v in a.split(",") if v] + \
          [{"type": "AAAA", "value": v} for v in aaaa.split(",") if v]
    blocked = any(x["value"] in ("0.0.0.0", "::") for x in ans)
    rows.append({"time": datetime.fromtimestamp(float(t), timezone.utc).isoformat(),
                 "client": client, "question": {"name": name}, "answer": ans,
                 "reason": "FilteredBlackList" if blocked else "NotFilteredNotFound"})
json.dump({"data": rows}, sys.stdout)
EOF
mv -f "$tmp/querylog.json" "$STATE/querylog.json"
chmod 644 "$STATE/querylog.json"

echo "tvgw-extract: archived $added new pcap(s); archive rows sni/http/dns" \
	"$(wc -l <"$ARCHIVE/sni.tsv")/$(wc -l <"$ARCHIVE/http.tsv")/$(wc -l <"$ARCHIVE/dns.tsv");" \
	"report files ($WINDOW): $(wc -l <"$STATE/sni.tsv") sni, $(wc -l <"$STATE/http.tsv") http, $(wc -l <"$tmp/view.dns") dns"
