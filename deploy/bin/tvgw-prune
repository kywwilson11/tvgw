#!/bin/bash
# Keep TV pcaps under PCAP_DAYS days and PCAP_MAX_GB GiB (tvgw.conf; defaults 7 / 1.5).
# Everything useful is in /var/lib/tvgw/tvgw.db within the hour; pcaps are raw evidence only.
set -euo pipefail
[ ! -f /etc/tvgw/tvgw.conf ] || . /etc/tvgw/tvgw.conf
DIR=/var/lib/tvgw/pcap
DAYS=${PCAP_DAYS:-7}
MAX_KB=$(awk -v g="${PCAP_MAX_GB:-1.5}" 'BEGIN { printf "%d", g * 1024 * 1024 }')

find "$DIR" -name '*.pcap' -mtime +"$DAYS" -delete
while [ "$(du -sk "$DIR" | cut -f1)" -gt "$MAX_KB" ]; do
	oldest=$(ls -1tr "$DIR"/*.pcap 2>/dev/null | head -1)
	[ -n "$oldest" ] || break
	rm -f -- "$oldest"
done
