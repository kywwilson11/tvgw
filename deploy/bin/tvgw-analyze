#!/bin/bash
# tvgw-analyze: hourly from tvgw-analyze.timer. Reads the TV (LG webOS, Samsung Tizen), ingests the hour
# into the store, then writes the reports under /var/lib/tvgw/reports from the store:
#   latest.txt / latest.json         the last 24 h, refreshed every run
#   daily/YYYY-MM-DD.txt / .json     one per finished calendar day, written once from 03:20 (backfilled 14 days)
#   weekly/YYYY-Www.txt / .json      one per finished ISO week (Mon-Sun), written once from Monday 03:20
#   action.txt                       (plain) the plain brief's action for the newest daily file, for the
#                                    login message: `<tier><tab><text>`, or empty when nothing needs a person
# Runs missed while the Pi was off are made up on the next run. With BRIEF_STYLE=plain each daily .txt
# starts with the plain brief; absent or full, the daily files are what they were (design decision 58).
set -euo pipefail
umask 027 # everything this job writes (TV readings, reports) is root:adm 640 / 750
REPORTS=/var/lib/tvgw/reports
STATE=/var/lib/tvgw
. /etc/tvgw/tvgw.conf 2>/dev/null || true

exec 9>/run/lock/tvgw-analyze.lock
flock -n 9 || { echo "tvgw-analyze: already running"; exit 0; }
install -d -m 2750 -g adm "$REPORTS" "$REPORTS/daily" "$REPORTS/weekly"

# TV settings drift check over the LAN API (LG webOS, and a Samsung read without pairing); needs the TV
# on, so keep the last good reading. tvcheck exits 1 when the TV did not answer and 4 when the gateway is
# not paired with it (it then asked the TV nothing: a reading never pairs, design decision 54); neither is
# a reading. Exit 5 is each reader's own: for an LG, the TV refused the gateway's key at an earlier
# reading, so nothing was asked (a refused key is never sent again until `tvgw tv pair`) and it is no
# reading; for a Samsung, an answer that is not a Samsung TV's, kept so the store records it once
if [ "${PROFILE:-lg-webos}" = lg-webos ] || [ "${PROFILE:-lg-webos}" = samsung-tizen ]; then
	rc=0
	/usr/local/bin/tvgw tvcheck >"$STATE/.tvcheck.tmp" 2>&1 || rc=$?
	if [ "$rc" -ne 1 ] && [ "$rc" -ne 4 ] && { [ "$rc" -ne 5 ] || [ "${PROFILE:-lg-webos}" = samsung-tizen ]; }; then
		{ echo "read $(date -Is)"; cat "$STATE/.tvcheck.tmp"; } >"$STATE/tvcheck.txt"
		[ "$rc" -eq 0 ] || echo "tvgw-analyze: $(grep WARNING "$STATE/.tvcheck.tmp")"
	fi
	# one line per hour: when was the TV on, in standby, or unreachable (asleep). No power line means
	# unreachable when the TV did not answer, unknown when it answered but the power read failed or when
	# nothing was asked (not paired, or the key refused)
	power=$(sed -nE 's/^power = (.*)/\1/p' "$STATE/.tvcheck.tmp"); app=$(sed -nE 's/^app = (.*)/\1/p' "$STATE/.tvcheck.tmp")
	[ -n "$power" ] || { power=unknown; [ "$rc" -ne 1 ] || power=unreachable; }
	# tab-separated: webOS states contain spaces ('Active Standby', 'Screen Off') and lgwebos.clean turns
	# tabs into spaces, so the delimiter cannot occur in a value. The stamp is ISO with the UTC offset:
	# unambiguous when the clocks change (a naive 01:20 happens twice in November)
	printf '%s\t%s\t%s\n' "$(date -Is)" "$power" "$app" >>"$STATE/tvcheck-history.log"
	rm -f "$STATE/.tvcheck.tmp"
fi

# The store: flows, DNS, finished pcaps, URL-filter log, TV state, odd ports, rule history
/usr/local/bin/tvgw ingest || echo "tvgw-analyze: WARNING: tvgw ingest reported problems"

# write PREFIX [tvgw report args]: PREFIX.txt and PREFIX.json, replaced atomically
write() {
	local out=$1
	shift
	if /usr/local/bin/tvgw report "$@" >"$out.txt.tmp" 2>&1 && /usr/local/bin/tvgw report "$@" --json >"$out.json.tmp" 2>/dev/null; then
		mv -f "$out.txt.tmp" "$out.txt" && mv -f "$out.json.tmp" "$out.json"
	else
		rm -f "$out.txt.tmp" "$out.json.tmp"
		echo "tvgw-analyze: WARNING: tvgw report $* failed"
	fi
}

write "$REPORTS/latest"

# Days and weeks end once, but their evidence lands late: conntrack reports an idle connection
# 2 h 04 min after its last packet and dumpcap closes each pcap when its clock hour ends, so a finished day
# or week is written once, at the first run at least SETTLE seconds after it ends (03:20 with the
# hourly timer), and only where the store has data. AdGuard writes its query log in batches of
# querylog.size_memory entries, which on a quiet night can come after 03:20: those last lookups are
# in the store and the weekly file, not in the day's (docs/research/data-architecture-2026-10.md,
# open questions 4, 5)
SETTLE=10800
plain=()
[ "${BRIEF_STYLE:-full}" != plain ] || plain=(--with-plain)
oldest=$(/usr/local/bin/tvgw sql "SELECT CAST(MIN(t) AS INTEGER) FROM dns" 2>/dev/null | tail -1 | tr -d ' ')
[[ "$oldest" =~ ^[0-9]+$ ]] || oldest=$(date +%s)
settled=$(($(date +%s) - SETTLE))
today=$(date +%F)
written=()
for i in $(seq 1 14); do
	day=$(date -d "$today -$i days" +%F)
	end=$(date -d "$day +1 day" +%s)
	[ "$end" -le "$settled" ] && [ "$end" -gt "$oldest" ] && [ ! -f "$REPORTS/daily/$day.txt" ] || continue
	write "$REPORTS/daily/$day" --day "$day" ${plain[@]+"${plain[@]}"}
	written+=("$day")
done
# (plain) the action of the newest daily file, rewritten when that file is newer than it; a day with
# nothing for a person leaves it empty
for i in $(seq 1 14); do
	day=$(date -d "$today -$i days" +%F)
	[ -f "$REPORTS/daily/$day.txt" ] || continue
	if [ ! -f "$REPORTS/action.txt" ] || [ "$REPORTS/daily/$day.txt" -nt "$REPORTS/action.txt" ]; then
		if /usr/local/bin/tvgw brief "$day" --action >"$REPORTS/action.txt.tmp" 2>/dev/null; then
			mv -f "$REPORTS/action.txt.tmp" "$REPORTS/action.txt"
		else
			rm -f "$REPORTS/action.txt.tmp"
			echo "tvgw-analyze: WARNING: tvgw brief $day --action failed"
		fi
	fi
	break
done
this_mon=$(date -d "$today -$(($(date +%u) - 1)) days" +%F)
mon=$(date -d "$this_mon -7 days" +%F)
week=$(date -d "$mon" +%G-W%V)
end=$(date -d "$mon +7 days" +%s)
if [ "$end" -le "$settled" ] && [ "$end" -gt "$oldest" ] && [ ! -f "$REPORTS/weekly/$week.txt" ]; then
	write "$REPORTS/weekly/$week" --week "$week"
	written+=("$week")
fi
echo "tvgw-analyze: latest refreshed; new reports: ${written[*]:-none}; see $REPORTS"
