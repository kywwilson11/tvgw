#!/bin/bash
# Refresh the DoH/DoT resolver IP set from DOH_LIST_URL, then reload rules.
# IPs inside /etc/tvgw/doh-exclude.txt CIDRs (shared CDN edges) are never blocked, nor (dohguard) those inside
# the owner's /etc/tvgw/doh-exclude.local.txt, which the installer never writes.
# (listguard) A refresh that would drop more than DOH_DROP_MAX percent of the last refresh taken is held back
# (design decision 68): what it would drop stays blocked and its new entries are added (less any entry the
# exclusions now cover), the last refresh taken is kept in /var/lib/tvgw/doh4.base, and
# /var/lib/tvgw/doh4.held says so for tvgw verify (doh4_held, doh4_fresh) and the brief. --accept takes it.
# (dohguard) A listed network that holds an address the TV fetches payload from, as the store says, is left
# out as an exclusion's is (design decision 95); /var/lib/tvgw/doh4.spared counts them for tvgw verify
# (doh4_loaded). A store that cannot be read keeps the old list.
set -euo pipefail
accept=0
case "${1:-}" in
--accept) accept=1 ;;
"") ;;
*)
	echo "usage: tvgw-doh-update [--accept]" >&2
	exit 2
	;;
esac
. /etc/tvgw/tvgw.conf
: "${DOH_DROP_MAX:=20}"
[ -n "${DOH_LIST_URL:-}" ] || { echo "tvgw: DOH_LIST_URL not set"; exit 0; }
# without the exclusions the next apply would block every CDN edge in the list
[ -s /etc/tvgw/doh-exclude.txt ] || { echo "tvgw: /etc/tvgw/doh-exclude.txt missing or empty; keeping old list" >&2; exit 1; }

raw=$(mktemp)
# staged beside its destination so the last step is a rename: an apply in the window (the dispatcher,
# a deploy) reads either the old list or the new one, never an empty or half-written file
tmp=$(mktemp /var/lib/tvgw/.doh4.XXXXXX)
trap 'rm -f "$raw" "$tmp"' EXIT
held=/var/lib/tvgw/doh4.held
base=/var/lib/tvgw/doh4.base
spared=/var/lib/tvgw/doh4.spared
curl -fsSL --proto '=https' --proto-redir '=https' --max-filesize 8000000 --max-time 60 -o "$raw" "$DOH_LIST_URL"

rc=0
python3 -I - "$raw" /etc/tvgw/doh-exclude.txt /var/lib/tvgw/doh4.txt "$DOH_DROP_MAX" "$accept" "$held" \
	"$base" /var/lib/tvgw/tvgw.db "$spared" /etc/tvgw/doh-exclude.local.txt >"$tmp" <<'EOF' || rc=$?
import bisect, ipaddress, json, os, re, sqlite3, sys, time

def entries(path):
    try:
        lines = open(path).read().splitlines()
    except FileNotFoundError:
        return []
    out = []
    for line in lines:
        m = re.match(r"\s*([0-9]{1,3}(?:\.[0-9]{1,3}){3}(?:/[0-9]{1,2})?)", line)
        if m:
            try:
                out.append(ipaddress.ip_network(m.group(1), strict=False))
            except ValueError:
                pass
    return out

# (dohguard) the shipped exclusions, which every install replaces, and the owner's own, which none touches
exclude = entries(sys.argv[2]) + entries(sys.argv[10])

# (dohguard) Every new TCP 443 connection to an address in the list is reset, so a list that names one the
# TV fetches from, by its source's mistake or on purpose, takes that away. Such an address is one the TV
# pulled USED_BYTES or more from over TCP 443 in the last USED_DAYS, summed over the connections it began
# within ANSWERED_WITHIN after the gateway's filter answered it with that address. Two weeks of DNS over
# HTTPS for a TV is tens of megabytes at the very most, an hour of video is hundreds; and a resolver the TV
# reaches by a built-in address follows no answer of the filter's, whose lists refuse the resolvers' names,
# so another name's answer at another time does not make it in use. A day is what the address gate and
# namebound take for "the filter gave it" (dnsgate.TTL); the second after it is the start's rounding, which
# conntrack gives in whole seconds. The window is no longer than answer_ip keeps its rows
# (namebound.ANSWER_IP_DAYS, 35 days). The answer is found by answer_ip's index on (ip, t).
USED_DAYS = 14
USED_BYTES = 50 * 2**20
ANSWERED_WITHIN = 86400
USED = """SELECT f.dst FROM flows f WHERE f.proto = 'tcp' AND f.dport = 443 AND f.t_end >= :since
AND EXISTS (SELECT 1 FROM answer_ip a WHERE a.ip = f.dst
AND a.t BETWEEN COALESCE(f.t_start, f.t_end) - :within AND COALESCE(f.t_start, f.t_end) + 1)
GROUP BY f.dst HAVING SUM(f.bytes_down) >= :bytes"""

def in_use(path):
    """The addresses the TV fetches from, as sorted integers; none before the first hourly ingest makes
    the store, as on a first install."""
    if not os.path.exists(path):
        return []
    conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=60)
    try:
        since = time.time() - USED_DAYS * 86400
        rows = conn.execute(USED, {"since": since, "bytes": USED_BYTES, "within": ANSWERED_WITHIN}).fetchall()
    finally:
        conn.close()
    return sorted(int(ipaddress.IPv4Address(dst)) for (dst,) in rows)

try:
    used = in_use(sys.argv[8])
except (sqlite3.Error, ValueError) as e:
    # taken unchecked, the refresh could reset what the TV fetches from; a list kept 8 days fails doh4_fresh
    print(f"tvgw: the store cannot be read ({e}); keeping old list", file=sys.stderr)
    sys.exit(1)

def fetched_from(n):
    i = bisect.bisect_left(used, int(n.network_address))  # the first address in use at or after its start
    return i < len(used) and used[i] <= int(n.broadcast_address)

def listed(n):
    return n.prefixlen >= 16 and not any(n.subnet_of(x) for x in exclude)

def keep(nets):
    # (dohguard) a network the TV fetches from is left out as an excluded one is, in this refresh and in the
    # last refresh taken alike, so the bound below never counts it as a drop
    return {n for n in nets if listed(n) and not fetched_from(n)}

fetched = set(entries(sys.argv[1]))
kept = keep(fetched)
spared = sum(1 for n in fetched if fetched_from(n) and listed(n))
# A ceiling as well as the floor below: the list is fetched from a third party every day and every
# address in it is reset for the TV on port 443, so a list that grew past anything a resolver list can
# be (a compromised or broken source) would black out the TV's HTTPS, not block resolvers. The list in
# use has about 1,500 single addresses; the limits are thirty times that, and sixty /16 networks.
MAX_ENTRIES, MAX_ADDRESSES = 50_000, 4_000_000
total = sum(n.num_addresses for n in kept)
if len(kept) > MAX_ENTRIES or total > MAX_ADDRESSES:
    print(
        f"tvgw: the DoH list names {len(kept)} networks covering {total} addresses, more than a resolver"
        f" list can ({MAX_ENTRIES} entries, {MAX_ADDRESSES} addresses); keeping old list",
        file=sys.stderr,
    )
    sys.exit(1)
# (listguard) A bound on how much one refresh may drop, as well: a source that went from about 1,500 entries
# to 60 would pass the floor and unblock every resolver it lost. The share is of the entries of the last
# refresh taken that no entry of this one covers, after today's exclusions, so an exclusion added to free
# a CDN edge never counts as a drop. HaGeZi's list dropped 1.7 to 2.1% a day from 2026-11-01 to 2026-11-08
# and 4.5% over the week; the default bound of 20% is about ten times a day of that. A last refresh under
# the floor of 50 entries was never a whole list, so any refresh may replace it.
MIN_ENTRIES = 50
limit = sys.argv[4]
if not (limit.isdigit() and 1 <= int(limit) <= 100):
    print(f"tvgw: DOH_DROP_MAX={limit!r}: expected 1 to 100 (percent); keeping old list", file=sys.stderr)
    sys.exit(1)
limit, accept, held, base = int(limit), sys.argv[5] == "1", sys.argv[6], sys.argv[7]
written = set(entries(sys.argv[3]))
# the last refresh taken: the list in force, or, while a hold goes on, the copy kept when it began (the
# list in force then also holds the new entries of the refreshes held since)
taken = keep(set(entries(base)) if os.path.exists(base) else written)

def covered(n):
    return n in kept or any(n.supernet(new_prefix=p) in kept for p in range(16, n.prefixlen))

def write_whole(path, text):
    part = path + ".tmp"
    with open(part, "w") as fh:
        fh.write(text)
    os.chmod(part, 0o640)  # the state directory's setgid bit gives it the adm group
    os.replace(part, path)

def note_spared():
    """(dohguard) doh4.spared, for tvgw verify: how many networks of the refresh just judged were left out
    because the TV fetches from them, and when; never which, since that would say what the TV fetches from.
    With none left out there is no record."""
    if spared:
        write_whole(sys.argv[9], json.dumps({"spared": spared, "t": time.time()}))
        many = spared > 1
        print(
            f"tvgw: {spared} network{'s' if many else ''} of the refreshed DoH list left out: the TV fetches"
            f" from {'them' if many else 'it'}",
            file=sys.stderr,
        )
    elif os.path.exists(sys.argv[9]):
        os.remove(sys.argv[9])

dropped = sum(1 for n in taken if not covered(n))
share = 100 * dropped / len(taken) if taken else 0.0
if len(taken) >= MIN_ENTRIES and share > limit:
    if accept:
        print(f"tvgw: taking the refresh on request: it drops {dropped} of {len(taken)} entries", file=sys.stderr)
    else:
        try:
            prev = json.load(open(held))
            prev = prev if isinstance(prev, dict) else {}
        except (OSError, ValueError):
            prev = {}
        now = time.time()
        if not os.path.exists(base):  # the hold begins: keep the last refresh taken, whole
            write_whole(base, "".join(f"{n}\n" for n in sorted(written)))
        record = {
            "since": prev.get("since") or now,
            "t": now,
            # when the last refresh was taken, which doh4_fresh measures while the list in force changes
            "accepted": prev.get("accepted") or os.stat(sys.argv[3]).st_mtime,
            "in_force": len(taken),
            "fetched": len(kept),
            "dropped": dropped,
            "max": limit,
        }
        write_whole(held, json.dumps(record))
        print(
            f"tvgw: the refreshed DoH list would drop {dropped} of the {len(taken)} entries of the last refresh"
            f" taken ({share:.0f}%, over DOH_DROP_MAX={limit}%); keeping them blocked and adding its new"
            " entries (tvgw-doh-update --accept takes it)",
            file=sys.stderr,
        )
        # the last refresh taken and this one's new entries, both under today's exclusions: nothing the
        # source dropped is unblocked, a resolver it added is blocked, an address an exclusion frees goes,
        # and (dohguard) so does a network the TV fetches from
        note_spared()
        union = taken | kept
        if union == written:
            sys.exit(3)
        print("\n".join(str(n) for n in sorted(union)))
        sys.exit(4)
# (dohguard) the floor below refuses a shorter refresh: the list in force and its record stay as they are
if len(kept) >= MIN_ENTRIES:
    note_spared()
print("\n".join(str(n) for n in sorted(kept)))
EOF

# 3: held back, and the list in force is already the last refresh taken plus this one's new entries;
# 4: held back, and it is written so
case $rc in
0) ;;
4)
	chgrp adm "$tmp"
	chmod 640 "$tmp"
	mv -f "$tmp" /var/lib/tvgw/doh4.txt
	/usr/local/sbin/tvgw-apply
	exit 1
	;;
*) exit 1 ;;
esac

# Refuse an empty or truncated download rather than unblocking everything
n=$(grep -c . "$tmp" || true)
[ "$n" -ge 50 ] || { echo "tvgw: only $n DoH IPs fetched; keeping old list" >&2; exit 1; }
chgrp adm "$tmp"
chmod 640 "$tmp"
mv -f "$tmp" /var/lib/tvgw/doh4.txt
rm -f "$held" "$base"
echo "tvgw: $n DoH IPs loaded"
exec /usr/local/sbin/tvgw-apply
