#!/bin/bash
# Refresh the DoH/DoT resolver IP set from DOH_LIST_URL, then reload rules.
# IPs inside /etc/tvgw/doh-exclude.txt CIDRs (shared CDN edges) are never blocked.
# (listguard) A refresh that would drop more than DOH_DROP_MAX percent of the last refresh taken is held back
# (design decision 68): what it would drop stays blocked and its new entries are added (less any entry the
# exclusions now cover), the last refresh taken is kept in /var/lib/tvgw/doh4.base, and
# /var/lib/tvgw/doh4.held says so for tvgw verify (doh4_held, doh4_fresh) and the brief. --accept takes it.
set -euo pipefail
accept=0
case "${1:-}" in
--accept) accept=1 ;;
"") ;;
*)
	echo "usage: tvgw-doh-update [--accept]" >&2
	exit 2
	;;
esac
. /etc/tvgw/tvgw.conf
: "${DOH_DROP_MAX:=20}"
[ -n "${DOH_LIST_URL:-}" ] || { echo "tvgw: DOH_LIST_URL not set"; exit 0; }
# without the exclusions the next apply would block every CDN edge in the list
[ -s /etc/tvgw/doh-exclude.txt ] || { echo "tvgw: /etc/tvgw/doh-exclude.txt missing or empty; keeping old list" >&2; exit 1; }

raw=$(mktemp)
# staged beside its destination so the last step is a rename: an apply in the window (the dispatcher,
# a deploy) reads either the old list or the new one, never an empty or half-written file
tmp=$(mktemp /var/lib/tvgw/.doh4.XXXXXX)
trap 'rm -f "$raw" "$tmp"' EXIT
held=/var/lib/tvgw/doh4.held
base=/var/lib/tvgw/doh4.base
curl -fsSL --proto '=https' --proto-redir '=https' --max-filesize 8000000 --max-time 60 -o "$raw" "$DOH_LIST_URL"

rc=0
python3 -I - "$raw" /etc/tvgw/doh-exclude.txt /var/lib/tvgw/doh4.txt "$DOH_DROP_MAX" "$accept" "$held" "$base" >"$tmp" <<'EOF' || rc=$?
import ipaddress, json, os, re, sys, time

def entries(path):
    try:
        lines = open(path).read().splitlines()
    except FileNotFoundError:
        return []
    out = []
    for line in lines:
        m = re.match(r"\s*([0-9]{1,3}(?:\.[0-9]{1,3}){3}(?:/[0-9]{1,2})?)", line)
        if m:
            try:
                out.append(ipaddress.ip_network(m.group(1), strict=False))
            except ValueError:
                pass
    return out

exclude = entries(sys.argv[2])

def keep(nets):
    return {n for n in nets if n.prefixlen >= 16 and not any(n.subnet_of(x) for x in exclude)}

kept = keep(entries(sys.argv[1]))
# A ceiling as well as the floor below: the list is fetched from a third party every day and every
# address in it is reset for the TV on port 443, so a list that grew past anything a resolver list can
# be (a compromised or broken source) would black out the TV's HTTPS, not block resolvers. The list in
# use has about 1,500 single addresses; the limits are thirty times that, and sixty /16 networks.
MAX_ENTRIES, MAX_ADDRESSES = 50_000, 4_000_000
total = sum(n.num_addresses for n in kept)
if len(kept) > MAX_ENTRIES or total > MAX_ADDRESSES:
    print(
        f"tvgw: the DoH list names {len(kept)} networks covering {total} addresses, more than a resolver"
        f" list can ({MAX_ENTRIES} entries, {MAX_ADDRESSES} addresses); keeping old list",
        file=sys.stderr,
    )
    sys.exit(1)
# (listguard) A bound on how much one refresh may drop, as well: a source that went from about 1,500 entries
# to 60 would pass the floor and unblock every resolver it lost. The share is of the entries of the last
# refresh taken that no entry of this one covers, after today's exclusions, so an exclusion added to free
# a CDN edge never counts as a drop. HaGeZi's list dropped 1.7 to 2.1% a day from 2026-11-01 to 2026-11-08
# and 4.5% over the week; the default bound of 20% is about ten times a day of that. A last refresh under
# the floor of 50 entries was never a whole list, so any refresh may replace it.
MIN_ENTRIES = 50
limit = sys.argv[4]
if not (limit.isdigit() and 1 <= int(limit) <= 100):
    print(f"tvgw: DOH_DROP_MAX={limit!r}: expected 1 to 100 (percent); keeping old list", file=sys.stderr)
    sys.exit(1)
limit, accept, held, base = int(limit), sys.argv[5] == "1", sys.argv[6], sys.argv[7]
written = set(entries(sys.argv[3]))
# the last refresh taken: the list in force, or, while a hold goes on, the copy kept when it began (the
# list in force then also holds the new entries of the refreshes held since)
taken = keep(set(entries(base)) if os.path.exists(base) else written)

def covered(n):
    return n in kept or any(n.supernet(new_prefix=p) in kept for p in range(16, n.prefixlen))

def write_whole(path, text):
    part = path + ".tmp"
    with open(part, "w") as fh:
        fh.write(text)
    os.chmod(part, 0o640)  # the state directory's setgid bit gives it the adm group
    os.replace(part, path)

dropped = sum(1 for n in taken if not covered(n))
share = 100 * dropped / len(taken) if taken else 0.0
if len(taken) >= MIN_ENTRIES and share > limit:
    if accept:
        print(f"tvgw: taking the refresh on request: it drops {dropped} of {len(taken)} entries", file=sys.stderr)
    else:
        try:
            prev = json.load(open(held))
            prev = prev if isinstance(prev, dict) else {}
        except (OSError, ValueError):
            prev = {}
        now = time.time()
        if not os.path.exists(base):  # the hold begins: keep the last refresh taken, whole
            write_whole(base, "".join(f"{n}\n" for n in sorted(written)))
        record = {
            "since": prev.get("since") or now,
            "t": now,
            # when the last refresh was taken, which doh4_fresh measures while the list in force changes
            "accepted": prev.get("accepted") or os.stat(sys.argv[3]).st_mtime,
            "in_force": len(taken),
            "fetched": len(kept),
            "dropped": dropped,
            "max": limit,
        }
        write_whole(held, json.dumps(record))
        print(
            f"tvgw: the refreshed DoH list would drop {dropped} of the {len(taken)} entries of the last refresh"
            f" taken ({share:.0f}%, over DOH_DROP_MAX={limit}%); keeping them blocked and adding its new"
            " entries (tvgw-doh-update --accept takes it)",
            file=sys.stderr,
        )
        # the last refresh taken and this one's new entries, both under today's exclusions: nothing the
        # source dropped is unblocked, a resolver it added is blocked, an address an exclusion frees goes
        union = taken | kept
        if union == written:
            sys.exit(3)
        print("\n".join(str(n) for n in sorted(union)))
        sys.exit(4)
print("\n".join(str(n) for n in sorted(kept)))
EOF

# 3: held back, and the list in force is already the last refresh taken plus this one's new entries;
# 4: held back, and it is written so
case $rc in
0) ;;
4)
	chgrp adm "$tmp"
	chmod 640 "$tmp"
	mv -f "$tmp" /var/lib/tvgw/doh4.txt
	/usr/local/sbin/tvgw-apply
	exit 1
	;;
*) exit 1 ;;
esac

# Refuse an empty or truncated download rather than unblocking everything
n=$(grep -c . "$tmp" || true)
[ "$n" -ge 50 ] || { echo "tvgw: only $n DoH IPs fetched; keeping old list" >&2; exit 1; }
chgrp adm "$tmp"
chmod 640 "$tmp"
mv -f "$tmp" /var/lib/tvgw/doh4.txt
rm -f "$held" "$base"
echo "tvgw: $n DoH IPs loaded"
exec /usr/local/sbin/tvgw-apply
