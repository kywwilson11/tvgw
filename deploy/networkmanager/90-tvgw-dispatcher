#!/bin/sh
# tvgw: re-apply routing when an interface comes up (table-100 routes vanish on link down)
[ -r /etc/tvgw/tvgw.conf ] && . /etc/tvgw/tvgw.conf
# (uplink) on the uplink's up and DHCP events: whether its address and its router moved since the last such
# event, as two words for the spool line, addr= and gw= (changed, same, or new when there is no earlier one
# since boot). NetworkManager passes the address as "address/prefix gateway" and the router apart. The
# addresses stay in /run/tvgw/wan.last, root's alone and gone at reboot; the spool never holds one
moved=
if [ "$1" = "${WAN_IF:-wlan0}" ]; then
	case "$2" in
	up | dhcp4-change)
		addr=${IP4_ADDRESS_0%% *} gw=${IP4_GATEWAY:-}
		if [ -n "$addr" ]; then
			was=new last_addr='' last_gw=''
			if [ -r /run/tvgw/wan.last ]; then
				was=old
				read -r last_addr last_gw </run/tvgw/wan.last || true
			fi
			word() { # now, before: changed or same, or new when there is no before
				if [ "$was" = new ]; then echo new; elif [ "$1" = "$2" ]; then echo same; else echo changed; fi
			}
			moved=$(printf '\taddr=%s\tgw=%s' "$(word "$addr" "$last_addr")" "$(word "$gw" "$last_gw")")
			{ [ -d /run/tvgw ] || mkdir -m 755 /run/tvgw; } 2>/dev/null
			{ (umask 077; printf '%s %s\n' "$addr" "$gw" >/run/tvgw/wan.last.tmp && mv -f /run/tvgw/wan.last.tmp /run/tvgw/wan.last); } 2>/dev/null
		fi
		;;
	esac
fi
# (ledger) every event on the uplink, the TV port and PIA's tunnel (OpenVPN tun0 or WireGuard wgpia0),
# one line in the change ledger's spool (design decision 48), never readable by others; a failed write
# never stops the apply below
case "$1" in "${WAN_IF:-wlan0}" | "${TV_IF:-eth0}" | tun0 | wgpia0 | "${VPN_IF:-tun0}") { (umask 027; printf '%s\tdispatcher\t%s\t%s%s\n' "$(date +%s)" "$1" "$2" "$moved" >>/var/lib/tvgw/changes.spool); } 2>/dev/null ;; esac
# (reliability) with VPN_DNS_SEAL=on, this computer's own plain lookups are held off the uplink from the
# moment it comes up, before the VPN's tunnel can, until the tunnel is up (below) or the hold ends by
# itself (design decision 73); never the TV's lookups, and a failure here never stops the apply
if [ "${VPN_DNS_SEAL:-off}" = on ] && [ "$1" = "${WAN_IF:-wlan0}" ] && [ "$2" = up ]; then
	# what it says (a hold whose time is spent) goes to the journal under tvgw-seal
	/usr/local/bin/tvgw seal hold 2>&1 | logger -t tvgw-seal || true
fi
# (web) the page listens on the uplink's address, read when it starts: a new address restarts it, without
# waiting (--no-block), so the apply below is never held up. try-restart touches it only when it runs
case "$moved" in *addr=changed* | *addr=new*) systemctl --no-block try-restart tvgw-web.service >/dev/null 2>&1 || true ;; esac
case "$2" in
up | dhcp4-change)
	case "$1" in
	"${WAN_IF:-wlan0}" | "${TV_IF:-eth0}") exec /usr/local/sbin/tvgw-apply ;;
	esac
	# (events) the VPN's tunnel, from VPN_IF as tvgw-apply reads it: auto watches both of PIA's names
	# (tun0 for OpenVPN, wgpia0 for WireGuard), none watches no tunnel
	case "${VPN_IF:-auto}" in
	auto) vpn="tun0 wgpia0" ;;
	none) vpn="" ;;
	*) vpn=$VPN_IF ;;
	esac
	for v in $vpn; do
		if [ "$1" = "$v" ]; then
			# (reliability) the tunnel is up: the hold on this computer's own lookups ends
			[ "${VPN_DNS_SEAL:-off}" != on ] || /usr/local/bin/tvgw seal release 2>&1 | logger -t tvgw-seal || true
			exec /usr/local/sbin/tvgw-apply
		fi
	done
	;;
esac
