# tvgw settings. Copied to /etc/tvgw/tvgw.conf on first install; run `sudo tvgw-apply` after
# changing firewall settings, `sudo ./install.sh` after changing the TV identity lines. The shell
# scripts source this file: quote a value with a space in it ("Mon 04:10"), or the shell runs the
# rest of the line as a command and the script stops there.

# ---- the TV (site-specific; never commit real values) ----
TV_MAC=00:00:00:00:00:00   # wired MAC of the TV, pinned by DHCP; leave the placeholder and the installer finds the TV (tvgw discover)
TV_IP=10.10.10.17          # its fixed address on the gateway's TV subnet (inside TV_NET, not GW_IP)
TV_NAME=tv                 # DHCP hostname
PROFILE=lg-webos           # which bundled profile categorizes and filters (src/tvgw/profiles)

# ---- the gateway's TV side (deploy/README.md#the-tv-side); re-run install.sh after a change ----
TV_IF=eth0                 # the port the TV is cabled to; never WAN_IF
TV_NET=10.10.10.0/24       # the TV subnet: private, /16 to /27, one the home network does not use; DHCP hands out its 10th to 20th hosts
GW_IP=10.10.10.1           # the gateway's address on it, outside that pool; AdGuard Home must listen here

# ---- uplink toward the home router ----
WAN_IF=wlan0
WAN_GW=192.168.1.1

# direct: TV traffic exits via WAN_IF to the router (streaming-friendly)
# vpn:    TV traffic exits via a VPN tunnel (tun0); it is blackholed if the VPN drops
UPLINK=direct

# yes: reject UDP/443 so apps fall back to TCP+TLS, keeping server names (SNI) visible
BLOCK_QUIC=yes

# no:  log TV traffic to ports other than 80/123/443 (journalctl -k -g tvgw-oddport), still allow it
# yes: reject it too. Flip after two weeks of empty "Unexpected ports" lines covering a firmware
# check, a cold boot, a Content Store install and every app you use (docs/operations.md).
STRICT_PORTS=no

# count: keep a set of every address the TV's own lookups returned in the last day (fed by
#        tvgw-dnsgate from AdGuard's answers) and count, and log a sample of, new connections to
#        any other address: hardcoded servers and DNS bypass become numbers in the brief
#        ("to addresses DNS never gave") instead of guesses. Nothing is blocked.
# off:   no set, no counting.
DNSGATE=count

# full:    tvgw-pcap captures the TV port with dumpcap, by byte patterns (connection flags, port 80,
#          UDP, the start of a TLS or HTTP request).
# headers: a prototype: the firewall hands the first 8 packets of each TV connection to NFLOG and
#          tvgw-pcap-headers captures those (docs/capture.md). After a change: sudo tvgw-apply, then
#          sudo systemctl restart tvgw-pcap; a deploy does both.
CAPTURE_MODE=full

# The daily analyst (needs /etc/tvgw/claude.key). The model it asks and how hard it thinks.
# Prices per million tokens in/out as of 2026-10: claude-opus-5-5 $4/$20 (the default; a day costs
# about $0.07), claude-sonnet-5-5 $2/$10, claude-haiku-5-5 $0.10/$0.50, claude-fable-5-1 $10/$50.
# Effort: low | medium | high | xhigh | max. high reads a day's pack well; xhigh/max cost more and
# take longer; medium is the model's own default.
ANALYST_MODEL=claude-opus-5-5
ANALYST_EFFORT=high
# When it runs and what it reads. ANALYST_SCHEDULE: a time of day for a daily run, `hourly`, or any
# systemd calendar expression (`"*-*-* 06,18:00:00"` for twice a day). ANALYST_WINDOW: `day` reads the
# previous calendar day; `6h` reads the last six hours up to the run. Match them: hourly runs with a
# 1h window, a daily run with `day`. `tvgw analyst --since 6h --model ... --effort ...` runs one by hand.
ANALYST_SCHEDULE=03:50
ANALYST_WINDOW=day
# The weekly pass reads the whole ISO week (Monday to Sunday) that just ended, with a model of its
# own: the default is the most capable one, since a week is where the harder judgements live.
# About $0.40 to $0.60 a week at list price. `off` disables the pass. "Day HH:MM" or a systemd
# calendar expression for the schedule, quoted.
ANALYST_WEEKLY_MODEL=claude-fable-5-1
ANALYST_WEEKLY_EFFORT=high
ANALYST_WEEKLY_SCHEDULE="Mon 04:10"
# Autonomy (design decision 20). off: proposals only. auto: a `block` the daily model proposes with low
# risk is applied by the gateway itself when every gate agrees: the name was seen on two or more days
# and carried no payload (median under 16 KB down per connection, under 2 MB in the window); a second,
# different model (ANALYST_VERIFIER_MODEL, asked to refute) clears it; at most three a day. The rule
# goes into AUTO_RULES, a file the machine owns (your profile's rules are never edited), then AdGuard;
# the TV is watched live for ten minutes (downloads and the foreground app) and the rule is on
# probation for a day with an hourly re-check (tvgw-autoblock.timer); any collapse takes it out again.
# `sudo tvgw undo` reverts the newest; deleting the file reverts all. The analyst is not even asked on
# a day with nothing new (TV off, or only names already judged).
ANALYST_APPLY=off
ANALYST_VERIFIER_MODEL=claude-fable-5-1
ANALYST_VERIFIER_EFFORT=xhigh
AUTO_RULES=/var/lib/tvgw/auto.rules

# (ledger) The change ledger (design decision 48). on: `tvgw verify --record` also samples the
# gateway's own counters every 10 minutes (boot id, link flaps, AdGuard restarts, conntrack, the VPN,
# Wi-Fi signal, list file times; read-only, each optional), the hourly ingest turns them and the
# spool lines of tvgw-apply, the dispatcher and install.sh into the `changes` table, the brief prints
# "Changes in effect", and the hourly check runs judge v2 beside the shipped judge without letting it
# decide anything. off: none of that (the brief leaves out "Changes in effect"; rows already in the
# store stay there).
LEDGER=on
# Clean demand TV hours judge v2 needs before it would pass a machine rule (1 to 336). A starting
# value: `sudo tvgw autoblock calibrate --by-class` measures what the store supports.
JUDGE2_CLEAN_HOURS=6

# Maintained list of DoH/DoT resolver IPv4s; refreshed daily by tvgw-doh-update.
DOH_LIST_URL=https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/ips/doh.txt

# Resolver nginx uses for the vendor file-service names it proxies (the URL filter). Not AdGuard,
# which rewrites those names to the gateway itself. With a VPN client that blocks other DNS, use
# the VPN provider's resolver address here.
URL_FILTER_RESOLVER=1.1.1.1

# ---- data retention ----
DB_DAYS=365        # rows in /var/lib/tvgw/tvgw.db
PCAP_DAYS=7        # raw pcaps are evidence only once ingested
PCAP_MAX_GB=1.5
