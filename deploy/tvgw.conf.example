# tvgw settings. Copied to /etc/tvgw/tvgw.conf on first install; run `sudo tvgw-apply` after
# changing firewall settings, `sudo ./install.sh` after changing the TV identity lines. The shell
# scripts source this file: quote a value with a space in it ("Mon 04:10"), or the shell runs the
# rest of the line as a command and the script stops there.

# ---- the TV (site-specific; never commit real values) ----
TV_MAC=00:00:00:00:00:00   # wired MAC of the TV, pinned by DHCP; leave the placeholder and the installer finds the TV (tvgw discover)
TV_IP=10.10.10.17          # its fixed address on the gateway's TV subnet (inside TV_NET, not GW_IP)
TV_NAME=tv                 # DHCP hostname
# TV_COUNTRY=                # two lower-case letters (de, ca): LG names its clock and store hosts by country; empty = us
PROFILE=generic-tv         # which bundled profile categorizes and filters (src/tvgw/profiles); tvgw setup picks it for your TV

# ---- the gateway's TV side (docs/reference/settings.md#the-tv-side); re-run install.sh after a change ----
TV_IF=eth0                 # the port the TV is cabled to; never WAN_IF
TV_NET=10.10.10.0/24       # the TV subnet: private, /16 to /27, one the home network does not use; DHCP hands out its 10th to 20th hosts
GW_IP=10.10.10.1           # the gateway's address on it, outside that pool; AdGuard Home must listen here

# (guard) The Pi's other services, which never talk to the TV: each one installed gets a systemd drop-in
# with IPAddressDeny=TV_NET (and the [Socket] one when its socket unit is active), so it is closed to the
# TV whatever nftables holds; avahi-daemon also gets deny-interfaces=TV_IF. Installed instances of
# qbittorrent-nox@ are matched as well. Names that are not installed are skipped. `none` for none.
# dnsmasq, nginx, AdGuardHome and tvgw's own units serve the TV and are refused here. Quoted: it has
# spaces. Re-run install.sh after a change (design decision 42).
CO_TENANT_UNITS="smbd nmbd xrdp shairport-sync nqptp avahi-daemon ssh jupyterhub"

# ---- uplink toward the home router ----
WAN_IF=wlan0
WAN_GW=192.168.1.1
# How tvgw-apply finds the router. literal, which a file without this line means: WAN_GW as written.
# auto: WAN_IF's default route at each apply, then the last one it saw, then WAN_GW (keep WAN_GW
# written, for an older release to read). sudo tvgw setup writes auto when the router gives this
# computer its address. After a change: sudo tvgw-apply
# WAN_GW_MODE=literal

# direct: TV traffic exits via WAN_IF to the router (streaming-friendly)
# vpn:    TV traffic exits via the VPN tunnel (VPN_IF); it is blackholed if the VPN drops
UPLINK=direct

# The VPN client's tunnel, for UPLINK=vpn, the dispatcher's re-apply when the tunnel comes up, and the
# count of the Pi's own lookups that leave by WAN_IF instead (design decision 44).
# auto: tun0 (PIA's OpenVPN), else wgpia0 (its WireGuard, reported the default for new PIA installs), whichever
#       exists at each apply. A name: that interface. none: the Pi runs no VPN client (no leak count).
# New connections from tun0 and wgpia0 to the Pi are dropped whatever this says.
VPN_IF=auto

# yes: reject UDP/443 so apps fall back to TCP+TLS, keeping server names (SNI) visible
BLOCK_QUIC=yes

# no:  log TV traffic to ports other than 80/123/443 (journalctl -k -g tvgw-oddport), still allow it
# yes: reject it too. Flip after two weeks of empty "Unexpected ports" lines covering a firmware
# check, a cold boot, a Content Store install and every app you use (docs/use/daily-brief.md).
STRICT_PORTS=no

# yes: reset the TV's TCP connections to LG's ad-tech ports (4001, 4431, 4445, 4447, 8180, 8883: ACR
#      fingerprints, Alphonso provisioning, LG ads, an IoT hub), count them ("adtech ports" under Firewall
#      held) and log a sample (journalctl -k -g tvgw-adport). The CX has never used one; any attempt is
#      the brief's ACR red line. Checked before STRICT_PORTS, so "Unexpected ports" lists only unknown ports.
# no:  leave those ports to STRICT_PORTS like any other.
ADTECH_PORT_WALL=yes

# count: keep a set of every address the TV's own lookups returned in the last day (fed by
#        tvgw-dnsgate from AdGuard's answers) and count, and log a sample of, new connections to
#        any other address: hardcoded servers and DNS bypass become numbers in the brief
#        ("to addresses DNS never gave") instead of guesses. Nothing is blocked.
# off:   no set, no counting.
DNSGATE=count

# full:    tvgw-pcap captures the TV port with dumpcap, by byte patterns (connection flags, port 80,
#          UDP, the start of a TLS or HTTP request).
# headers: a prototype: the firewall hands the first 8 packets of each TV connection to NFLOG and
#          tvgw-pcap-headers captures those (docs/how-it-works/capture.md). After a change: sudo tvgw-apply, then
#          sudo systemctl restart tvgw-pcap; a deploy does both.
CAPTURE_MODE=full

# The daily analyst (needs /etc/tvgw/claude.key). The model it asks and how hard it thinks.
# Prices per million tokens in/out as of 2026-10: claude-opus-5-5 $4/$20 (the default; a day costs
# about $0.07), claude-sonnet-5-5 $2/$10, claude-haiku-5-5 $0.10/$0.50, claude-fable-5-1 $10/$50.
# Effort: low | medium | high | xhigh | max. high reads a day's pack well; xhigh/max cost more and
# take longer; medium is the model's own default.
ANALYST_MODEL=claude-opus-5-5
ANALYST_EFFORT=high
# When it runs and what it reads. ANALYST_SCHEDULE: a time of day for a daily run, `hourly`, or any
# systemd calendar expression (`"*-*-* 06,18:00:00"` for twice a day). ANALYST_WINDOW: `day` reads the
# previous calendar day; `6h` reads the last six hours up to the run. Match them: hourly runs with a
# 1h window, a daily run with `day`. `tvgw analyst --since 6h --model ... --effort ...` runs one by hand.
ANALYST_SCHEDULE=03:50
ANALYST_WINDOW=day
# The weekly pass reads the whole ISO week (Monday to Sunday) that just ended, with a model of its
# own: the default is the most capable one, since a week is where the harder judgements live.
# About $0.40 to $0.60 a week at list price. `off` disables the pass. "Day HH:MM" or a systemd
# calendar expression for the schedule, quoted.
ANALYST_WEEKLY_MODEL=claude-fable-5-1
ANALYST_WEEKLY_EFFORT=high
ANALYST_WEEKLY_SCHEDULE="Mon 04:10"
# Autonomy (design decisions 20 and 41). off: proposals only. auto: a `block` the daily model proposes
# with low risk is applied by the gateway itself when every gate agrees: the name was seen on two or
# more days, the TV connected to it (or never used what its lookups returned) and it carried no payload
# (median under 16 KB down per connection, under 2 MB in the window); a second, different model
# (ANALYST_VERIFIER_MODEL, asked to refute) clears it; at most three a day, one on trial at a time (the
# rest wait their turn). The rule goes into AUTO_RULES, a file the machine owns (your profile's rules
# are never edited), then AdGuard; the TV is watched live for ten minutes (downloads and the
# foreground app), at once when it is on with an app in front or else at the first hourly check that
# finds it so, and the rule is on probation for at least a day with an hourly re-check
# (tvgw-autoblock.timer). Two TV hours running with almost no streaming take it out again; a trial with
# too little viewing runs longer, up to 14 days, then stays in place, listed as untested. `sudo tvgw
# undo` reverts the newest; deleting the file reverts all. The analyst is not even asked on a day with
# nothing new (TV off, or only names already judged).
ANALYST_APPLY=off
ANALYST_VERIFIER_MODEL=claude-fable-5-1
ANALYST_VERIFIER_EFFORT=xhigh
AUTO_RULES=/var/lib/tvgw/auto.rules

# (ledger) The change ledger (design decision 48). on: `tvgw verify --record` also samples the
# gateway's own counters every 10 minutes (boot id, link flaps, AdGuard restarts, conntrack, the VPN,
# Wi-Fi signal, list file times; read-only, each optional), the hourly ingest turns them and the
# spool lines of tvgw-apply, the dispatcher and install.sh into the `changes` table, the brief prints
# "Changes in effect", and the hourly check runs judge v2 beside the shipped judge without letting it
# decide anything. off: none of that (the brief leaves out "Changes in effect"; rows already in the
# store stay there).
LEDGER=on
# Clean demand TV hours judge v2 needs before it would pass a machine rule (1 to 336). A starting
# value: `sudo tvgw autoblock calibrate --by-class` measures what the store supports.
JUDGE2_CLEAN_HOURS=6

# Maintained list of DoH/DoT resolver IPv4s; refreshed daily by tvgw-doh-update.
DOH_LIST_URL=https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/ips/doh.txt

# Resolver nginx uses for the vendor file-service names it proxies (the URL filter). Not AdGuard,
# which rewrites those names to the gateway itself. With a VPN client that blocks other DNS, use
# the VPN provider's resolver address here: behind PIA's kill switch 1.1.1.1 never answers nginx,
# since PIA rejects the Pi's plain DNS to any server but its own once it has connected.
URL_FILTER_RESOLVER=1.1.1.1

# ---- AdGuard Home (docs/how-it-works/adguard.md); run `sudo tvgw adguard apply` after a change ----
# A second resolver for AdGuard's fallback_dns, asked only when every upstream returns an error (a
# provider outage). Encrypted and by address, from another operator than DNS_UPSTREAMS, for example
# DNS_FALLBACK=https://<address>/dns-query; comma-separated for more than one. Empty: no fallback, and
# nothing is ever asked of a resolver you did not name. It cannot help while the VPN tunnel is down.
DNS_FALLBACK=
# Which addresses AdGuard Home answers DNS on (docs/how-it-works/adguard.md#the-listen-setting).
# gateway: GW_IP and 127.0.0.1 on port 53, so the TV and this computer and never the home network;
#          AdGuard starts after the network and is restarted until GW_IP exists. New installs use it.
# keep:    AdGuard's own addresses stay as its wizard or its web UI set them, which is also what a
#          settings file without this line means. Before you switch a running gateway to gateway,
#          check that no other device on the home network uses its AdGuard Home.
# After a change: sudo ./install.sh (the drop-in), which runs the apply.
ADGUARD_LISTEN=gateway
# Your own allow and block rules for this gateway: sudo tvgw allow NAME and sudo tvgw block NAME write
# them, and tvgw rules --local lists them (docs/use/blocking.md#your-own-rules).
# The file does not exist until the first of those commands. Never the same file as AUTO_RULES.
# LOCAL_RULES=/etc/tvgw/local.rules

# ---- data retention ----
DB_DAYS=365        # rows in /var/lib/tvgw/tvgw.db
# The autonomy's decisions (every gate, second-model answer, canary and verdict, with the margins and
# the second model's tokens): `keep` keeps them all, as the machine's rules are kept; a number of days
# prunes older rows at the hourly ingest. Your choice; nothing has decided it for you.
DECISIONS_DAYS=keep
PCAP_DAYS=7        # raw pcaps are evidence only once ingested
PCAP_MAX_GB=1.5
QUERYLOG_DAYS=90   # days of AdGuard's own query log (querylog.interval), 1 to 365; the ingest reads it hourly
STATS_DAYS=90      # days of AdGuard's statistics (statistics.interval), 1 to 365
# (record) Days the systemd journal keeps (kernel log lines, dnsmasq's DHCP lines with the TV's MAC),
# through /etc/systemd/journald.conf.d/60-tvgw.conf, which install.sh writes; it is read after a
# 50-*.conf of your own and so overrides it for every service. off: tvgw ships no drop-in.
JOURNAL_DAYS=14

# ---- minimization at ingest (docs/use/privacy.md#keep-less) ----
# keep:    plain-HTTP requests are stored with their query strings
# lengths: each query value is stored as its length (?id=<12>); biz_code is kept for the GFTS table
URI_VALUES=keep
# off: names are stored as seen
# on:  names under the profile's title-bearing zones (its FAST category) are stored as a keyed HMAC,
#      t-<epoch>-<tag>.<zone>, with keys in /var/lib/tvgw/name-keys (never in a backup), one per 90 days
NAME_HMAC=off

# ---- the brief (docs/reference/brief-sections.md#the-plain-brief) ----
# plain: tvgw brief prints the day in plain words (tvgw brief --full prints the engineering brief),
#        and each daily file under /var/lib/tvgw/reports/daily starts with that summary. New installs
#        use it.
# full:  the engineering brief and the daily files as before, which is also what a settings file
#        without this line means.
BRIEF_STYLE=plain

# ---- reserved: settings for features this release does not have yet ----
# Each line shows a key and its default, the value a file without it gets, which is how the gateway
# behaves today. tvgw checks a value you set here, but nothing reads these yet: setting one changes
# nothing until the release that uses it (docs/reference/settings.md).
# UPDATE_CHECK=off                   # weekly: ask GitHub weekly whether a newer tvgw exists; never installs
# UPDATE_REPO=kywwilson11/tvgw       # the GitHub repository, owner/name, whose releases that check reads
# TV_PAIR_MANIFEST=auto              # unread: the manifest is chosen per key (tvgw tv pair --manifest) and recorded with it
# TV_DHCP=open                       # pinned: DHCP answers only TV_MAC on TV_IF; open: any device there
# BACKUP_KEEP=7                      # days of daily store copies tvgw backup keeps, plus the newest
# TV_PORT_MANAGER=auto               # what puts GW_IP on TV_IF: networkmanager, tvgw, or auto (decided once)
# NETWATCH=auto                      # netlink watcher: off, on, shadow (logs only), auto (on with tvgw above)
# DEPLOY_WINDOW=03:30-05:30          # local time when a deploy that changes the network may run
