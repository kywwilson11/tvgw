[Unit]
Description=LG TV gateway: last week's evidence read by the weekly model as proposals (applied on probation only with ANALYST_APPLY=auto)
After=tvgw-analyze.service network-online.target
Wants=network-online.target

[Service]
# Python reads, writes and prints UTF-8 whatever the system locale says (the Pi's was en_US with no
# charset, which is latin-1, and the first ellipsis in the analyst's own text crashed a run)
Environment=PYTHONUTF8=1
Type=oneshot
# a oneshot has no start timeout unless given one; one streamed request over a week's pack
TimeoutStartSec=20min
ExecStart=/usr/local/bin/tvgw analyst --weekly
# proposals are root:adm 640 under the reports directory (setgid adm)
UMask=0027
Nice=10
# reads the store and the key (root-only), writes under the state directory and, with
# ANALYST_APPLY=auto, AdGuard's config (design decision 20); talks to the API and the TV
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tvgw /opt/AdGuardHome
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
