[Unit]
Description=LG TV gateway: yesterday's evidence read by Claude as proposals (applied on probation only with ANALYST_APPLY=auto)
After=tvgw-analyze.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# a oneshot has no start timeout unless given one; one streamed request, a few minutes at most
TimeoutStartSec=20min
ExecStart=/usr/local/bin/tvgw analyst
# proposals are root:adm 640 under the reports directory (setgid adm)
UMask=0027
Nice=10
# reads the store and the key (root-only), writes under the state directory and, with
# ANALYST_APPLY=auto, AdGuard's config (design decision 20); talks to the API and the TV
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tvgw /opt/AdGuardHome
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
