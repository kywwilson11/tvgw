[Unit]
Description=LG TV gateway: a checked copy of the store (VACUUM INTO + quick_check), one a day kept for seven days
After=tvgw-analyze.service

[Service]
# Python reads, writes and prints UTF-8 whatever the system locale says (the Pi's was en_US with no
# charset, which is latin-1, and the first ellipsis in the analyst's own text crashed a run)
Environment=PYTHONUTF8=1
Type=oneshot
# a oneshot has no start timeout unless given one; the store is small and the copy takes seconds
TimeoutStartSec=10min
ExecStart=/usr/local/bin/tvgw backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# reads the settings and the store, writes only under the state directory
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tvgw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
