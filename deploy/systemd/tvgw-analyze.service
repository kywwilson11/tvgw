[Unit]
Description=LG TV gateway: ingest the hour, read the TV, write traffic reports
After=tvgw.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tvgw-analyze
# a TV that answers the LAN API and then stalls, or a tshark that never returns, must not block
# the next hour: the timer fires again only after this unit has finished
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# the job parses packets from the TV and the internet (tshark, dropped to nobody) and reads logs:
# it needs the state and log directories, the lock directory, and nothing else writable
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tvgw /var/log/tvgw /run/lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
