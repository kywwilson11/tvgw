[Unit]
Description=LG TV gateway: ingest the hour, read the TV, write the reports from the store
After=tvgw.service

[Service]
# Python reads, writes and prints UTF-8 whatever the system locale says (the Pi's was en_US with no
# charset, which is latin-1, and the first ellipsis in the analyst's own text crashed a run)
Environment=PYTHONUTF8=1
Type=oneshot
ExecStart=/usr/local/sbin/tvgw-analyze
# a TV that answers the LAN API and then stalls, or a tshark that never returns, must not block
# the next hour: the timer fires again only after this unit has finished
TimeoutStartSec=45min
Nice=10
# if memory runs out this job dies before the resolver does
OOMScoreAdjust=500
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# the job parses packets from the TV and the internet (tshark, dropped to nobody) and reads logs:
# it needs the state and log directories, the lock directory, and nothing else writable
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tvgw /var/log/tvgw /run/lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
