[Unit]
Description=LG TV gateway: feed the DNS-gate set with the addresses the resolver hands the TV
# after the firewall, but not bound to it: a failed apply must not keep the evidence down all boot
After=tvgw.service
Wants=tvgw.service

[Service]
# root for two capabilities only: the packet capture (tcpdump) and the set updates (nft)
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_PACKET AF_NETLINK AF_UNIX AF_INET
SystemCallArchitectures=native
RestrictRealtime=yes
MemoryMax=128M
ExecStart=/usr/local/bin/tvgw dnsgate-feed
# exits 0 and stays down with DNSGATE=off; anything else comes back: quickly for a table that is
# gone for a moment during a re-apply, then more slowly (5 s doubling to 5 min) when tcpdump cannot
# start at all, instead of every five seconds for ever (167 restarts in a quarter hour on 2026-10-28)
Restart=on-failure
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=5min

[Install]
WantedBy=multi-user.target
