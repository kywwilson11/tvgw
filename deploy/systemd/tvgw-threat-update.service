[Unit]
Description=LG TV gateway: download the threat lists (count-only; nothing unless THREAT_LISTS=count)
After=network-online.target
Wants=network-online.target

[Service]
# Python reads, writes and prints UTF-8 whatever the system locale says
Environment=PYTHONUTF8=1
Type=oneshot
# each curl is capped at 10 min inside (threats.FETCH_SECONDS); a oneshot has no start timeout unless given one
TimeoutStartSec=40min
# with THREAT_LISTS=off it downloads nothing and removes the copies; it fails (and shows in
# `systemctl --failed`) when a list kept its old copy, as tvgw-doh-update does
ExecStart=/usr/local/bin/tvgw threats --update
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# It fetches public lists and writes their copies, nothing else. The threat lists' copies and the
# manifest go to /var/lib/tvgw/threat (StateDirectory: the one path it may write on disk; never the store,
# the rules or the pairing key beside it), the newly-registered lists' to /run/tvgw-threat, a tmpfs kept
# until the next boot (RuntimeDirectory, preserved between runs), so 100 MB a day never reach the card
StateDirectory=tvgw/threat
StateDirectoryMode=0750
RuntimeDirectory=tvgw-threat
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# the memory a line-by-line parse needs (about 25 MB measured) with room
MemoryMax=128M
UMask=0027
