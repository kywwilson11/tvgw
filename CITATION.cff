cff-version: 1.2.0
message: "If you use tvgw or its measurements, please cite it as below."
type: software
title: "tvgw"
abstract: "tvgw makes a Raspberry Pi the only way a smart TV reaches the internet: it forces the TV's DNS through a filter, blocks the ways around it, records what the TV does in a SQLite store and reports it in a daily brief."
authors:
  - name: "kywwilson11"
repository-code: "https://github.com/kywwilson11/tvgw"
url: "https://github.com/kywwilson11/tvgw"
license: MIT
version: "0.5.0"
date-released: "2026-11-14"
keywords:
  - smart-tv
  - privacy
  - raspberry-pi
  - dns-filtering
  - adguard-home
  - nftables
  - webos
  - acr
  - telemetry
  - network-measurement
# (companies) the data tvgw ships under its own licence: a list of licences here would read as a choice
references:
  - type: data
    title: "AdGuard Companies DB"
    authors:
      - name: "AdGuard"
    repository-code: "https://github.com/AdguardTeam/companiesdb"
    license: CC-BY-SA-4.0
    notes: "A trimmed snapshot ships in tvgw as src/tvgw/data/companies.txt, and its advertising rows as src/tvgw/data/adfirms.txt, under CC BY-SA 4.0, not MIT (NOTICE)."
