#!/bin/sh
# tvgw preinst: AdGuard Home is a checked dependency, never bundled (design decision 25).
# It has no .deb to depend on, so the check is here, before dpkg unpacks anything: a host without it,
# or with a release older than the floor, keeps whatever it had and is told the command to run.
set -e
# ---- tvgw-adguard: AdGuard Home is a checked dependency, never bundled (design decision 25).
# POSIX sh, the same block in install.sh and packaging/scripts/preinst; AGH_MIN is
# verify.ADGUARD_MIN (tests/unit/test_packaging.py keeps the three equal). ----
AGH=/opt/AdGuardHome/AdGuardHome
AGH_MIN=0.107.79
# AdGuard Home's own release, the one tvgw pins (aghinstall.PIN: its version and the SHA-256 of each
# tarball, which tests/unit/test_packaging.py keeps equal here), never its unpinned install script
AGH_PIN=0.107.80
AGH_HINT="install the release tvgw pins, v$AGH_PIN, from https://github.com/AdguardTeam/AdGuardHome/releases/tag/v$AGH_PIN into /opt/AdGuardHome, then finish its first-run page"
case $(dpkg --print-architecture 2>/dev/null || true) in
arm64) AGH_TAR=AdGuardHome_linux_arm64.tar.gz AGH_SUM=d5e17d0d724418ddef8b7723ed8ade7eef4e621ec5b0e43a341859cca71a3d8f ;;
amd64) AGH_TAR=AdGuardHome_linux_amd64.tar.gz AGH_SUM=28593bc761d71469abdbc6f39ca42cbed763ec92b63082c729177b037ed51d18 ;;
*) AGH_TAR='' AGH_SUM='' ;;
esac
[ -z "$AGH_TAR" ] || AGH_HINT="install the release tvgw pins, checked by its SHA-256, then finish its first-run page (https://github.com/AdguardTeam/AdGuardHome#getting-started):
  curl -fsSLO https://github.com/AdguardTeam/AdGuardHome/releases/download/v$AGH_PIN/$AGH_TAR
  echo '$AGH_SUM  $AGH_TAR' | sha256sum -c
  sudo tar -xzf $AGH_TAR -C /opt
  sudo $AGH -s install"
version_at_least() { # is dotted version $1 at least $2? (a leading v is ignored)
	_have=${1#v}. _want=${2#v}.
	case $_have$_want in *[!0-9.]* | *..*) return 1 ;; esac
	while [ -n "$_want" ]; do
		_a=${_have%%.*} _b=${_want%%.*}
		_have=${_have#*.} _want=${_want#*.}
		[ "${_a:-0}" -gt "$_b" ] && return 0
		[ "${_a:-0}" -lt "$_b" ] && return 1
	done
	return 0
}
adguard_ok() { # AdGuard Home at $AGH, at AGH_MIN or later; otherwise AGH_ERR says what to do
	AGH_ERR=
	if [ ! -x "$AGH" ]; then
		AGH_ERR="AdGuard Home is not installed ($AGH is missing); $AGH_HINT"
		return 1
	fi
	AGH_VERSION=$("$AGH" --version 2>/dev/null | sed -n 's/.*v\([0-9][0-9.]*[0-9]\).*/\1/p' | head -n 1) || true
	if [ -z "$AGH_VERSION" ]; then
		AGH_ERR="could not read AdGuard Home's version from $AGH --version; reinstall it: $AGH_HINT"
		return 1
	fi
	if ! version_at_least "$AGH_VERSION" "$AGH_MIN"; then
		# once tvgw is installed the binary changes only through it (it checks the live config first)
		if [ -n "$(command -v tvgw)" ]; then
			_agh_up="download the new release and run: sudo tvgw adguard upgrade <its AdGuardHome binary>"
		else
			_agh_up="update it with its own updater before tvgw is installed: sudo $AGH --update"
		fi
		AGH_ERR="AdGuard Home v$AGH_VERSION is below v$AGH_MIN, the release with the 2026 DoH and DoQ fixes; $_agh_up"
		return 1
	fi
}
# ---- end tvgw-adguard ----
# Someone else's dnsmasq or nginx. install.sh gives dnsmasq the TV port alone with its DNS turned off
# (port=0 in /etc/dnsmasq.d/tvgw.conf), removes nginx's default site, and runs both under a sandbox
# that keeps them from the home network and from /home. On a computer whose dnsmasq or nginx already
# does a job of its own that would break the job, silently, so a fresh install is refused here, before
# dpkg unpacks anything, naming what it found. TVGW_TAKE_OVER=1 in the environment (the one-line
# installer passes its own through apt) lets tvgw take them over on purpose. Debian's own files pass:
# a dnsmasq.conf of comments (its conf-dir line included), /etc/dnsmasq.d/README, the default site.
# So does dpkg's copy of a packaged file, a name that ends in .dpkg-new, .dpkg-dist or .dpkg-old:
# Debian's dnsmasq is told to skip those (CONFIG_DIR in /etc/default/dnsmasq), so none is a setting
# in use. One is there on every computer that had no dnsmasq: apt unpacks dnsmasq in the same run, a
# moment before this script, and its README is README.dpkg-new until dpkg configures the package.
# 0.3.1 took that file for somebody's and refused every such install (CHANGELOG.md, 2026-11-05).
in_use() { # one line per file that says dnsmasq or nginx is already somebody's
	if [ -f /etc/dnsmasq.conf ] && grep -Ev '^[[:space:]]*(#|$|conf-dir=)' /etc/dnsmasq.conf | grep -q .; then
		echo "/etc/dnsmasq.conf holds settings"
	fi
	for f in /etc/dnsmasq.d/*; do
		[ -e "$f" ] || [ -L "$f" ] || continue
		case ${f##*/} in README | tvgw.conf | *.dpkg-new | *.dpkg-dist | *.dpkg-old) ;; *) echo "$f" ;; esac
	done
	for f in /etc/nginx/sites-enabled/*; do
		[ -e "$f" ] || [ -L "$f" ] || continue
		[ "${f##*/}" = default ] || echo "$f"
	done
	for f in /etc/nginx/conf.d/*; do
		[ -e "$f" ] || [ -L "$f" ] || continue
		[ "${f##*/}" = tvgw-gfts.conf ] || echo "$f"
	done
}
case "$1" in
install | upgrade)
	if ! adguard_ok; then
		echo "tvgw: $AGH_ERR" >&2
		echo "tvgw: nothing was changed; set up AdGuard Home first, then install tvgw again" >&2
		exit 1
	fi
	;;
esac
if [ "$1" = install ] && [ -z "${TVGW_TAKE_OVER:-}" ]; then
	found=$(in_use)
	if [ -n "$found" ]; then
		echo "tvgw: dnsmasq or nginx on this computer already does a job of its own:" >&2
		printf '%s\n' "$found" | sed 's/^/tvgw:   /' >&2
		echo "tvgw: tvgw turns dnsmasq's DNS off and gives it the TV port alone, removes nginx's default site and runs both under a sandbox, which would break that job." >&2
		echo "tvgw: use a computer that does not already run them, or move those settings away first. To let tvgw take them over anyway, run the installer with TVGW_TAKE_OVER=1 (curl ... | sudo env TVGW_TAKE_OVER=1 sh)." >&2
		echo "tvgw: nothing was changed" >&2
		exit 1
	fi
fi
exit 0
