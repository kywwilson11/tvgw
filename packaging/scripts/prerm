#!/bin/sh
# tvgw prerm. On removal: the timers first, so nothing starts half way, then the capture, then the
# firewall, whose stop turns forwarding off before it deletes the tables: the TV goes dark, never
# unfiltered (design decision 5). On an upgrade nothing stops: the new postinst re-runs install.sh,
# which re-applies the firewall in place without a gap, and reloads tvgw-guard, never restarts it
# (design decision 42).
set -e
case "$1" in
remove | deconfigure)
	[ -d /run/systemd/system ] || exit 0
	for unit in /usr/lib/tvgw/deploy/systemd/*.timer; do
		[ -e "$unit" ] && systemctl disable --now "${unit##*/}" >/dev/null 2>&1 || true
	done
	systemctl disable --now tvgw-pcap.service tvgw-flowlog.service tvgw-dnsgate.service tvgw-tvlive.service >/dev/null 2>&1 || true
	# (inpath) the DNS gate's in-path filler, where the settings ever enabled it: it empties its queue
	# and lets go, and the kernel passes the TV's DNS answers itself until the firewall goes below
	systemctl disable --now tvgw-dnsgate-inpath.service >/dev/null 2>&1 || true
	# (namebound) the live name count, where the settings ever enabled it: it holds nothing
	systemctl disable --now tvgw-names.service >/dev/null 2>&1 || true
	# (web) the page on the home network, where the settings turned it on: nothing listens after this
	systemctl disable --now tvgw-web.service >/dev/null 2>&1 || true
	# (guard) disabled, never stopped (it refuses a manual stop and has no ExecStop): the guard table
	# keeps the Pi closed to the TV until the next boot, or until `nft delete table inet tvgw_guard`
	systemctl disable tvgw-guard.service >/dev/null 2>&1 || true
	systemctl disable --now tvgw.service || echo "tvgw: tvgw.service did not stop cleanly; the TV stays filtered until a reboot" >&2
	;;
esac
exit 0
