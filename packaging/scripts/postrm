#!/bin/sh
# tvgw postrm: removes what install.sh wrote outside the package's own files, which dpkg removes
# itself. `remove` keeps the settings (/etc/tvgw), the logs and the store; `purge` also removes the
# settings, the logs and the tv-lan connection, and keeps the store, /var/lib/tvgw, which is a year
# of evidence a habitual purge must not destroy (design decision 23): it says how to
# delete it. AdGuard Home, its configuration and the tvgw-pcap and tvgw-web system users are left as they
# are.
# (uninstall) What the postinst recorded the install changed is given back: a dnsmasq apt installed for
# tvgw is stopped and switched off, since without tvgw's file it would answer DNS on every network the
# computer is on; on a purge, which deletes tv-lan, each connection install.sh had stopped from connecting
# on its own connects on its own again. `remove` keeps tv-lan, as it keeps the settings, and says so.
set -e
RECORD=/var/lib/tvgw/.installed-by-tvgw
brought() { [ -f "$RECORD" ] && grep -qx "package $1" "$RECORD"; }
stood_aside() { [ ! -f "$RECORD" ] || sed -n 's/^autoconnect //p' "$RECORD"; }
case "$1" in
remove | purge)
	rm -f /usr/local/sbin/tvgw-apply /usr/local/sbin/tvgw-doh-update /usr/local/sbin/tvgw-analyze
	rm -f /usr/local/bin/tvgw
	rm -f /etc/systemd/system/tvgw.service /etc/systemd/system/tvgw-*.service /etc/systemd/system/tvgw-*.timer
	rm -rf /etc/systemd/system/tvgw-analyst.timer.d /etc/systemd/system/tvgw-analyst-weekly.timer.d
	rm -rf /etc/systemd/system/tvgw-pcap.service.d /etc/systemd/system/tvgw-tvlive.service.d
	rm -rf /etc/systemd/system/tvgw-web.service.d # (web)
	rm -f /etc/systemd/system/*.wants/tvgw.service /etc/systemd/system/*.wants/tvgw-* # enabled with no systemd running
	rm -f /etc/systemd/system/nginx.service.d/tvgw.conf
	# (guard) the hardening and co-tenant drop-ins; the daemon-reload below lifts the co-tenants' filters.
	# avahi-daemon.conf keeps its deny-interfaces line (its backup is avahi-daemon.conf.tvgw-backup), and
	# the guard table stays in the kernel until the next boot
	rm -f /etc/systemd/system/dnsmasq.service.d/20-tvgw-hardening.conf
	rm -f /etc/systemd/system/*.service.d/10-tvgw-not-from-tv.conf /etc/systemd/system/*.socket.d/10-tvgw-not-from-tv.conf
	rm -f /etc/dnsmasq.d/tvgw.conf /etc/logrotate.d/tvgw
	rm -f /etc/sysctl.d/60-tvgw.conf # (events)
	# (events) the running kernel kept tvgw-apply's 0 (events only for connections a rule marks), and
	# no rule marks any now: its default again, best effort, so a later conntrack listener hears events
	sysctl -q -w net.netfilter.nf_conntrack_events=2 2>/dev/null || true
	rm -f /etc/systemd/journald.conf.d/60-tvgw.conf # (record) the journal's span; journald reads it at its next start
	rm -f /etc/NetworkManager/conf.d/90-tvgw.conf /etc/NetworkManager/dispatcher.d/90-tvgw
	rm -f /etc/nginx/conf.d/tvgw-gfts.conf
	rm -rf /etc/nginx/tvgw
	# nginx refuses to start with an include of a file that is gone; the rewrite keeps the file's owner
	# and mode, and touches it only when the line is there
	inc='include /etc/nginx/tvgw/stream.conf;'
	if [ -f /etc/nginx/nginx.conf ] && grep -qxF "$inc" /etc/nginx/nginx.conf; then
		grep -vxF "$inc" /etc/nginx/nginx.conf >/etc/nginx/nginx.conf.tvgw-new || true
		cat /etc/nginx/nginx.conf.tvgw-new >/etc/nginx/nginx.conf
		rm -f /etc/nginx/nginx.conf.tvgw-new
	fi
	rm -rf /opt/tvgw-venv /var/lib/tvgw/.unit-stamps
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		if brought dnsmasq; then
			systemctl disable --now dnsmasq.service >/dev/null 2>&1 || true
			echo "tvgw: dnsmasq came with tvgw and is now stopped and off, since without tvgw it would answer DNS on every network this computer is on; remove it with: sudo apt purge dnsmasq" >&2
		else
			systemctl try-restart dnsmasq.service || true
		fi
		if command -v nginx >/dev/null && nginx -t >/dev/null 2>&1; then systemctl try-reload-or-restart nginx.service || true; fi
		command -v nmcli >/dev/null && nmcli general reload conf >/dev/null 2>&1 || true
	fi
	;;
esac
if [ "$1" = remove ] && [ -n "$(stood_aside)" ]; then
	echo "tvgw: the TV port keeps tvgw's connection, tv-lan, as the settings are kept; sudo apt purge tvgw deletes it and gives the port back to the connection it had before" >&2
fi
if [ "$1" = purge ]; then
	rm -rf /etc/tvgw /var/log/tvgw
	command -v nmcli >/dev/null && nmcli con delete tv-lan >/dev/null 2>&1 || true
	ids=$(stood_aside)
	if [ -n "$ids" ]; then
		# (uninstall) every connection install.sh stopped from connecting on its own, unless deleted since
		known=$(nmcli -t -f UUID con show 2>/dev/null) || known=unreadable
		left=
		for id in $ids; do
			if [ "$known" != unreadable ] && ! printf '%s\n' "$known" | grep -qx "$id"; then
				continue
			fi
			if nmcli con modify "$id" connection.autoconnect yes >/dev/null 2>&1; then
				name=$(nmcli -g connection.id con show "$id" 2>/dev/null) || name=$id
				echo "tvgw: the connection $name connects on its own again, so the port works as it did before tvgw" >&2
			else
				left="$left $id"
				echo "tvgw: to give the TV port back to the connection it had before tvgw: sudo nmcli con modify $id connection.autoconnect yes" >&2
			fi
		done
		# what was given back leaves the record; a package line stays for a later purge
		{
			grep -v '^autoconnect ' "$RECORD" || true
			for id in $left; do echo "autoconnect $id"; done
		} >"$RECORD.new"
		if [ -s "$RECORD.new" ]; then
			chmod 640 "$RECORD.new" && mv -f "$RECORD.new" "$RECORD"
		else
			rm -f "$RECORD.new" "$RECORD"
		fi
	fi
	if [ -d /var/lib/tvgw ]; then
		echo "tvgw: the store and pcaps are kept in /var/lib/tvgw; delete them with: sudo rm -rf /var/lib/tvgw" >&2
	fi
fi
exit 0
